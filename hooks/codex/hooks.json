{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "CAIRN_DIR=\"$(pwd)/.cairn\" CAIRN_SESSION=codex bash \"${PLUGIN_ROOT}/hooks/cairn-sessionstart.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CAIRN_DIR=\"$(pwd)/.cairn\" CAIRN_SESSION=codex bash \"${PLUGIN_ROOT}/hooks/cairn-stop-codex.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
