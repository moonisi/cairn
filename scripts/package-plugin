#!/usr/bin/env bash
# Cairn Claude plugin 산출물을 표준 hook 위치로 패키징한다.
set -euo pipefail

usage() {
  printf 'usage: %s claude <output-dir>\n' "$0" >&2
}

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

runtime="$1"
out_dir="$2"
case "$runtime" in
  claude) ;;
  *) usage; exit 2 ;;
esac

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
hook_source="$repo_root/hooks/$runtime/hooks.json"

if [ ! -f "$hook_source" ]; then
  printf 'missing runtime hook source: %s\n' "$hook_source" >&2
  exit 1
fi

if [ -e "$out_dir" ]; then
  printf 'output directory already exists: %s\n' "$out_dir" >&2
  exit 1
fi

mkdir -p "$out_dir"
(
  cd "$repo_root"
  tar --exclude='.git' --exclude='__pycache__' --exclude='*.pyc' -cf - .
) | (
  cd "$out_dir"
  tar -xf -
)

# 산출물에는 Claude 표준 hooks/hooks.json만 남긴다.
# Codex hook은 plugin 산출물이 아니라 repo-local .codex/hooks.json adapter로 설치한다.
if [ -d "$out_dir/hooks/claude" ]; then
  rm -r "$out_dir/hooks/claude"
fi
cp "$hook_source" "$out_dir/hooks/hooks.json"
printf 'packaged %s plugin: %s\n' "$runtime" "$out_dir"
